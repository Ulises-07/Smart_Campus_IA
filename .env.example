# ============================================================
# Smart Campus IA - Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a Git.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
TZ=America/Tegucigalpa

# HTTPS con certificado autofirmado (produccion en red local).
# Dejalo en false mientras desarrollas.
HTTPS_ENABLED=false
HTTPS_KEY_PATH=./certs/server.key
HTTPS_CERT_PATH=./certs/server.crt

# --- Base de datos (MariaDB de XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_campus
DB_USER=sc_app
DB_PASSWORD=CAMBIA_ESTA_CLAVE
DB_CONNECTION_LIMIT=10

# --- Seguridad ---
# Genera cada secreto con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CAMBIA_ESTE_SECRETO
JWT_REFRESH_SECRET=CAMBIA_ESTE_OTRO_SECRETO
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Ollama (IA local) ---
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=30000

# --- Microservicio de vision (Fase 8) ---
VISION_ENABLED=false
VISION_URL=http://127.0.0.1:8000

# --- Archivos ---
# Fuera del directorio publico, a proposito.
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=25
BACKUP_DIR=./storage/backups
LOG_DIR=./storage/logs

# Ruta al mysqldump de XAMPP (para el script de respaldo)
# Windows: C:/xampp/mysql/bin/mysqldump.exe
# Linux:   /usr/bin/mysqldump
MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
